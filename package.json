{
  "name": "collateral-health-engine",
  "version": "1.0.0",
  "description": "A pure TypeScript domain engine for evaluating Collateral Arrangement health statuses and risk transitions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "lint": "npm run format:check && npm run typecheck",
    "smoke": "npm run build && node dist/smoke.js",
    "prepare": "husky"
  },
  "keywords": [
    "collateral",
    "risk",
    "ltv",
    "health",
    "finance",
    "domain-driven-design"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.2.2",
    "vitest": "^1.4.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
